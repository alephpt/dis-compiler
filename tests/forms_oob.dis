// an out of bounds index is a clean runtime error, never undefined behaviour

form Pixel <- $
    r <- u8.
    g <- u8.
    b <- u8.
    a <- u8.
^

def fb <- Pixel[4].

fb[0]::r <- 1.
fb[3]::r <- 2.
log -> fb[3]::r.

fb[4]::r <- 3.

log -> "unreachable".
