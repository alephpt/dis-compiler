// the arithmetic natives, unary and binary

def PI <- 3.14159265358979.

// sin and cos at the quarter turns
log -> sin -> 0.
log -> cos -> 0.
log -> floor -> (sin -> PI / 2) + 0.5.
log -> floor -> (cos -> PI) - 0.5.

// tan of an eighth turn is one
log -> floor -> (tan -> PI / 4) + 0.5.

// abs strips the sign from either side of zero
log -> abs -> 0 - 7.5.
log -> abs -> 7.5.
log -> abs -> 0.

// atan2 walks the full circle, so it recovers the angle of a known point
log -> floor -> ((atan2 -> 1, 1) * 4 / PI) + 0.5.
log -> floor -> ((atan2 -> 0, 0 - 1) * 4 / PI) + 0.5.

// pow, including roots and a negative exponent
log -> pow -> 2, 10.
log -> pow -> 9, 0.5.
log -> pow -> 2, 0 - 2.

// min and max pick a side
log -> min -> 3, 8.
log -> max -> 3, 8.
log -> min -> 0 - 3, 0 - 8.
log -> max -> 2.5, 2.5.

// they compose with each other and with the older natives
log -> max -> (min -> 100, 42), sqrt -> 16.
log -> floor -> pow -> (abs -> 0 - 3), 2.

// a clamp built out of min and max, the shape the renderer will use
op clamp <- v, lo, hi : $
    return min -> (max -> v, lo), hi.
^

log -> clamp -> 5, 0, 1.
log -> clamp -> 0 - 5, 0, 1.
log -> clamp -> 0.5, 0, 1.

// the length of a vector by way of pow
op len <- x, y : $
    return pow -> (x * x) + (y * y), 0.5.
^

log -> len -> 3, 4.
